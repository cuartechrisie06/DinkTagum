{
  "expo": {
    "name": "dink-tagum",
    "slug": "dink-tagum",
    "scheme": "dink-tagum",
    "version": "1.0.0",
    "description": "Pickleball & Sports Community App for Tagum City",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#06231D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06231D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinktagum.app",
      "backgroundColor": "#06231D"
    },
    "android": {
      "package": "com.dinktagum.app",
      "backgroundColor": "#06231D",
      "adaptiveIcon": {
        "backgroundColor": "#06231D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DinkTagum to use your location to show nearby pickleball courts."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DinkTagum to access your photos to set a profile picture or share a game photo."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E3EF26"
        }
      ]
    ]
  }
}
