# Copy this file to .env.local and add the values from Supabase Dashboard > Settings > API.
# These public client values are safe to embed in an Expo app; never add a secret/service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: CARTO basemap key for the dark map tiles (free: https://carto.com/basemaps/apikey).
# Without it the map falls back to keyless Esri Dark Gray tiles.
EXPO_PUBLIC_CARTO_BASEMAP_KEY=
