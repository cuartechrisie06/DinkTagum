# Copy this file to .env.seed.local (already gitignored) and fill in the
# service role key from Supabase Dashboard > Project Settings > API.
# NEVER put this key in .env.local or anywhere the Expo app can read it -
# it bypasses Row Level Security entirely. It is only used by
# scripts/seed-test-data.mjs, which you run from your own machine with:
#
#   node --env-file=.env.local --env-file=.env.seed.local scripts/seed-test-data.mjs
#
# or, on Windows PowerShell, by setting both variables in the current shell
# session before running `npm run seed:test-data` (see README.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
